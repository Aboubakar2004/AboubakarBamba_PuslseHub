# Copier en .env pour surcharger les valeurs par défaut (le .env réel n'est jamais commité).
# Les options en ligne de commande restent prioritaires sur ces variables.

# Port UDP du hub (partagé par le hub et le simulateur)
HUB_PORT=9000
# Interface d'écoute du hub (0.0.0.0 = toutes)
HUB_BIND=0.0.0.0
# Adresse du hub vue par le simulateur
HUB_HOST=127.0.0.1
# Nombre de seq récents mémorisés par appareil (distinction retard / doublon)
HUB_SEQ_WINDOW=64

# Seuils de la synthèse (unités physiques)
HUB_TEMP_WARNING_C=60
HUB_TEMP_CRITICAL_C=75
HUB_VOLTAGE_MIN_V=22
HUB_VOLTAGE_MAX_V=26
HUB_CURRENT_MAX_A=10
# Délai sans aucune trame avant qu'un appareil soit considéré muet
HUB_SILENT_AFTER_MS=3000

# Simulateur
SIM_DEVICES=50
SIM_HZ=20
SIM_HEARTBEAT_EVERY=20
